# Cổng mạng server lắng nghe (Mặc định: 5000)
PORT=5000

# Chế độ môi trường
NODE_ENV=production

# Khóa bí mật ký JWT Token cho tài khoản Admin (Nên đổi chuỗi ngẫu nhiên dài và bảo mật)
JWT_SECRET=zalo-admin-secret-key-change-in-production-2026-ubuntu-deployment

# Cấu hình Pinecone Vector Database
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx #vào 
PINECONE_HOST=https://xxxxxxxxxxxxxxxxxxxxxx.pinecone.io
PINECONE_INDEX=xxx
